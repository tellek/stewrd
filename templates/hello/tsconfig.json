{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true
  },
  "include": ["*.ts", "*.tsx", "../.stewrd/plugin-api.d.ts", "../.stewrd/assets.d.ts"],
  "exclude": ["dist", "node_modules"]
}
