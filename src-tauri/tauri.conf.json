{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stewrd",
  "version": "0.1.1",
  "identifier": "com.topher.stewrd",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "stewrd",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../src/assets/category-icons/*": "assets/category-icons/",
      "../bundled-plugins/notepad": "plugins/notepad",
      "../bundled-plugins/_template": "plugins/_template",
      "../ARCHITECTURE.md": "ARCHITECTURE.md",
      "../plugins/CLAUDE.md": "plugins/CLAUDE.md",
      "../plugins/build-plugin.mjs": "plugins/build-plugin.mjs",
      "../plugins/.stewrd/plugin-api.d.ts": "plugins/.stewrd/plugin-api.d.ts"
    }
  }
}
