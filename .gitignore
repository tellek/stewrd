bundled-plugins/

# Release packaging scratch/output (see scripts/package-update-zip.mjs)
update-zip-staging/
stewrd-v*-windows.zip
stewrd-v*-windows.zip.sig

# Serena MCP local project cache
.serena/

# Ad-hoc debug screenshots dropped in during a session
screenshots/

