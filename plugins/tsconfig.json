{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "types": ["react"]
  },
  "include": ["_template/**/*.ts", "_template/**/*.tsx", "marketplace/**/*.ts", "marketplace/**/*.tsx", ".stewrd/plugin-api.d.ts", ".stewrd/assets.d.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
